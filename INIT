Create View vw_orders_clean as
select	
	Invoice as Order_id,
	StockCode as Product_id,
	Quantity,
	Price,
	(Quantity * Price) as  Sales_amount
from bronze.Retail1
where 
	Invoice not like 'C%'
	AND Quantity > 0
	AND  Price >0

