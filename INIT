DROP VIEW vw_dim_products;
CREATE VIEW	vw_dim_products as
	SELECT DISTINCT
		Product_id,
		Description as Product_name
	FROM
	(
	SELECT 
		StockCode as Product_id,
		Description
	FROM  bronze.Retail1
	WHERE
		Invoice NOT LIKE'C%'
		AND Description IS NOT NULL
		AND Description <> 'NULL'
		AND Description <> 'check'
		AND Description <> 'found'
		AND Description <> 'damaged'
		AND Description <> 'damages'
		AND Description <> 'damages?'
		AND Description <> '?display?'
		AND Description <> 'damages/display'
		AND Description <> 'adjustment'
		AND Description <> 'returned'
		AND Description <> 'smashed'
		AND Description <> 'mailout'
		AND Description <> 'lost in space'
		AND Description <> 'wet/rusty'
		AND Description <> 'wet'
		AND Description <> 'on cargo order'
		AND Description <> 'wrongly marked'
		AND Description <> 'samples'
		AND Description <> 'dotcom'
		AND Description <> 'missing'
		AND Description <> '?'
		AND Description <> '??'
		AND Description <> '???'
		)t;

select * from vw_dim_products;

