use Raw;

select * from bronze.Retail1;

Create View vw_orders as
select	
	Invoice as Order_id,
	CAST(InvoiceDate as DATE) AS Order_date,
	Customer as Customer_id,
	Country
from bronze.Retail1
where 
	Invoice not like 'C%'
	AND InvoiceDate is not null
	AND Customer is not null		
group by 
	Invoice,
	CAST(InvoiceDate as DATE),
	Customer,
	Country;

select * from vw_orders;

CREATE VIEW vw_order_item as 
SELECT 
	Invoice as Order_ID,
	StockCode as Product_ID,
	Quantity ,
	Price as UnitPrice,
	Quantity * Price as Sales_amount
FROM bronze.Retail1
WHERE 
	Invoice	NOT LIKE 'C%'
	AND Quantity > 0
	AND Price > 0 ;

