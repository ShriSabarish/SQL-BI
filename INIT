CREATE VIEW vw_fact_sales as
SELECT 
	oc.Order_id,
	oc.Product_id,
	oc.Quantity,
	oc.Price,
	oc.Sales_amount,
	o.Order_date,
	o.Customer_id,
	o.Country
FROM vw_orders_clean oc
INNER JOIN vw_orders o
on oc.Order_id =  o.Order_id;

select  * from vw_fact_sales;

